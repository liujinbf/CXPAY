{
  "schema": 1,
  "id": "cxpay.wxpay.clerk_adapter",
  "slug": "wxpay_clerk_adapter",
  "name": "微信云端店员免挂适配器",
  "version": "1.1.0",
  "publisher": "cxpay.official",
  "description": "通过个人微信店员账号与独立 Gewe/iPad 协议服务接收到账通知；无需商户设备常驻，但存在账号风控和协议变化风险。",
  "payment_type": "wxpay",
  "collection_mode": "personal_qr",
  "monitor_mode": "callback",
  "requires": {
    "cxpay": ">=1.0.0 <2.0.0",
    "php": ">=8.1.0",
    "extensions": ["json", "openssl"]
  },
  "capabilities": {
    "dynamic_qr": false,
    "server_monitor": true,
    "account_authorization": true,
    "account_capability_detection": true,
    "payment_event_review": true,
    "operations_status": true
  },
  "permissions": {
    "outbound_domains": ["由管理员配置的公网 HTTPS 店员服务地址"],
    "callbacks": ["/notify/wxpay_clerk_adapter"],
    "scheduled_tasks": false,
    "secret_config": ["client_secret", "callback_secret", "callback_secret_previous"]
  },
  "drivers": [
    {
      "code": "wxpay_clerk_adapter",
      "class": "plugin\\cxpay\\wxpay_clerk_adapter\\Driver",
      "file": "src/Driver.php"
    }
  ]
}
