{
  "schema": 1,
  "id": "cxpay.alipay.accountlog_monitor",
  "slug": "alipay_accountlog_monitor",
  "name": "支付宝商家账单监控（手动配置）",
  "version": "1.0.1",
  "publisher": "cxpay.official",
  "description": "使用用户自行申请的支付宝开放平台应用查询商家账单，仅用于监控固定收款码到账。",
  "payment_type": "alipay",
  "collection_mode": "personal_qr",
  "monitor_mode": "server",
  "requires": {
    "cxpay": ">=1.0.0 <2.0.0",
    "php": ">=8.1.0",
    "extensions": ["json", "openssl"]
  },
  "capabilities": {
    "dynamic_qr": false,
    "server_monitor": true,
    "account_authorization": true,
    "stable_bill_id": true,
    "official_bill_api": true,
    "creates_official_payment_order": false,
    "automatic_application": true
  },
  "permissions": {
    "outbound_domains": ["openapi.alipay.com"],
    "callbacks": [],
    "scheduled_tasks": true,
    "secret_config": ["app_private_key"]
  },
  "drivers": [
    {
      "code": "alipay_accountlog_monitor",
      "class": "plugin\\cxpay\\alipay_accountlog_monitor\\Driver",
      "file": "src/Driver.php"
    }
  ]
}
