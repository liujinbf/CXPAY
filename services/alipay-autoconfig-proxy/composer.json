{
    "name": "cxpay/alipay-autoconfig-proxy",
    "description": "支付宝账单通道自动配置代理服务 —— 引导商户完成支付宝开放平台应用配置并自动回填至 CXPAY",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "AlipayAutoConfig\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
