# -----------------------------------------------------------------------
# AMC (Alipay Monitor Cloud) 环境变量示例配置
# -----------------------------------------------------------------------

# 主加密密钥 (Base64 编码的 32 字节密钥)
AMC_MASTER_KEY=

# 数据库 DSN (支持 SQLite 或 MySQL)
AMC_DSN=sqlite:runtime/alipay-monitor-cloud.sqlite
# AMC_DSN=mysql:host=127.0.0.1;dbname=alipay_cloud;charset=utf8mb4
# AMC_DB_USER=root
# AMC_DB_PASS=123456

# 服务监听地址
AMC_LISTEN=http://127.0.0.1:8788
