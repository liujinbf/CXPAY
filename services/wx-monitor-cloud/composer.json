{
  "name": "cxpay/wx-monitor-cloud",
  "description": "CXPAY 微信个人收款云监控协调服务",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "workerman/workerman": "^5.1",
    "guzzlehttp/guzzle": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "WxMonitorCloud\\": "src/"
    }
  },
  "suggest": {
    "ext-pdo_sqlite": "使用 SQLite 数据库时需要",
    "ext-pdo_mysql": "使用 MySQL 数据库时需要"
  }
}
