WXMC_LISTEN=http://0.0.0.0:8787
WXMC_WORKER_COUNT=1
WXMC_DSN=sqlite:runtime/wx-monitor-cloud.sqlite
# MySQL 示例：mysql:host=127.0.0.1;port=3306;dbname=wx_monitor_cloud;charset=utf8mb4
WXMC_DB_USER=
WXMC_DB_PASSWORD=
# 使用 `php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"` 单独生成，不要提交真实值。
WXMC_MASTER_KEY=
# 密钥运维命令按需设置：
# WXMC_KEY_ACTION=list
# WXMC_PROVISION_ID=cxpay-site-01
# WXMC_KEY_TYPE=request
# WXMC_KEY_GRACE_SECONDS=3600
# WXMC_KEY_ACTIVATE_AFTER_SECONDS=0
# WXMC_KEY_ID=key_xxxxxxxxxxxxxxxxxxxxxxxx
