{
    "name": "cxpay/framework",
    "type": "project",
    "description": "High Performance Next-Gen Aggregated Payment Gateway Framework based on Webman",
    "keywords": [
        "cxpay",
        "webman",
        "workerman",
        "payment-gateway",
        "epay"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1.0",
        "workerman/webman-framework": "^1.5.0",
        "illuminate/database": "^10.0",
        "illuminate/pagination": "^10.0",
        "illuminate/events": "^10.0",
        "illuminate/redis": "^10.0",
        "vlucas/phpdotenv": "^5.5",
        "guzzlehttp/guzzle": "^7.8",
        "yansongda/pay": "^3.5",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "ext-redis": "For higher Redis performance",
        "ext-event": "For higher EventLoop performance in Workerman"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/",
            "support\\": "support/"
        },
        "files": [
            "support/helpers.php"
        ]
    },
    "scripts": {
        "post-package-install": [
            "support\\Plugin::install"
        ],
        "post-package-update": [
            "support\\Plugin::install"
        ]
    }
}
