<Window x:Class="CXPayMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CXPAY 微信/支付宝 PC 收款监控端 v2.3 Pro" 
        Height="820" Width="1080" 
        MinHeight="740" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- 1. 现代统一定制文本输入框样式 (8px 丝滑圆角) -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="8" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 现代密码输入框样式 (8px 丝滑圆角) -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" CornerRadius="8" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. 现代下拉选择框 ToggleButton 模板 -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" CornerRadius="8" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#64748B"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#94A3B8"/>
                    <Setter TargetName="templateRoot" Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 4. 现代下拉选择框样式 (8px 丝滑圆角) -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,6,30,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot">
                            <ToggleButton x:Name="toggleButton" Grid.Column="0" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}" 
                                              IsHitTestVisible="false"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom">
                                <Border x:Name="dropDownBorder" MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                                        CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" 
                                        Margin="0,4,0,4">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. 现代主要圆角按钮样式 (8px 圆角) -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 6. 现代次要圆角按钮样式 (8px 圆角) -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 7. 现代操作高亮按钮 (8px 圆角) -->
        <Style x:Key="ModernEmeraldButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#047857"/>
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="btnBorder" Property="Background" Value="#D1FAE5"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernIndigoButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="BorderBrush" Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E0E7FF"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代卡片样式 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,18,20,20"/>
        </Style>

        <!-- 标签文字样式 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: 顶部 Header -->
            <RowDefinition Height="Auto"/> <!-- 1: 中部双卡片 (自适应高度) -->
            <RowDefinition Height="Auto"/> <!-- 2: 控制按钮栏 -->
            <RowDefinition Height="*"/>    <!-- 3: 底部日志终端 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部 Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,10,16,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo 方块 -->
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="#2563EB" Margin="0,0,12,0">
                    <TextBlock Text="CX" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 标题与副标题 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CXPAY 桌面收款监控端" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A"/>
                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2,6,2" Margin="10,0,0,0">
                            <TextBlock Text="v2.3 Pro" Foreground="#2563EB" FontWeight="Bold" FontSize="10"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="微信小账本、收款单与个人码本地 OCR 自动化监听中枢" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 状态徽章 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusPill" Background="#F1F5F9" CornerRadius="14" Padding="12,5,12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusText" Text="未启动" FontWeight="Bold" FontSize="11.5" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EFF6FF" CornerRadius="14" Padding="12,5,12,5">
                        <TextBlock x:Name="QueueText" Text="待上报: 0" FontWeight="Bold" FontSize="11.5" Foreground="#2563EB"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 中部双卡片配置区 (左侧商户专属信息，隐藏服务器原始URL与密钥) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左卡片：商户授权与通道信息 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="商户授权与通道状态" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                        
                        <!-- 云端连通指示器 -->
                        <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="10" Padding="8,3,8,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#16A34A" Margin="0,0,5,0"/>
                                <TextBlock Text="云端网关已连接" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 通道ID 与 设备ID -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="收款通道 ID (Channel)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtChannelId" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="绑定设备标识 (Device)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtDeviceId" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 支付分类 与 心跳间隔 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="支付类型分类" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbPayType" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="微信支付 (wxpay)" Tag="wxpay" IsSelected="True"/>
                                <ComboBoxItem Content="支付宝 (alipay)" Tag="alipay"/>
                                <ComboBoxItem Content="QQ 钱包 (qqpay)" Tag="qqpay"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="心跳同步间隔 (秒)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtPollSeconds" Text="5" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 高级网络设置折叠按钮 -->
                    <Expander Header="⚙️ 高级配置 (支持自定义主站与密钥)" Foreground="#64748B" FontSize="11.5" Margin="0,2,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="CXPAY 主站接入服务地址" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtServerUrl" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"/>

                            <TextBlock Text="通道上报 HMAC 密钥" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="TxtNotifySecret" Style="{StaticResource ModernPasswordBox}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 右卡片：微信窗口与采集模式 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="微信窗口与采集模式" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <!-- 采集模式 -->
                    <TextBlock Text="账单采集模式" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CmbCaptureMode" Style="{StaticResource ModernComboBox}" SelectionChanged="CmbCaptureMode_SelectionChanged" Margin="0,0,0,10">
                        <ComboBoxItem Content="微信收款小账本 / 收款单 (本地 OCR 视觉抓取)" IsSelected="True"/>
                        <ComboBoxItem Content="微信 Hook 极速模式 (后台免保持窗口)"/>
                        <ComboBoxItem Content="授权账单源模式 (外部 API 轮询)"/>
                    </ComboBox>

                    <!-- UI 模式窗口选择 -->
                    <StackPanel x:Name="PnlUiMode">
                        <TextBlock Text="目标微信记录窗口" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbWindowList" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="刷新微信窗口" Style="{StaticResource ModernSecondaryButton}" Click="BtnRefreshWindows_Click"/>
                            <Button Grid.Column="2" Content="智能可读性诊断" Style="{StaticResource ModernIndigoButton}" Click="BtnInspectWindow_Click"/>
                        </Grid>

                        <Button Content="复制小账本小程序链接" Style="{StaticResource ModernEmeraldButton}" Click="BtnCopyLink_Click"/>
                    </StackPanel>

                    <!-- Feed 模式配置 -->
                    <StackPanel x:Name="PnlFeedMode" Visibility="Collapsed">
                        <TextBlock Text="授权账单源 URL" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtFeedUrl" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="账单源访问令牌 (Token)" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="TxtFeedToken" Style="{StaticResource ModernPasswordBox}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. 操作按钮控制栏 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,9,12,9" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnToggleEngine" Content="启动挂机监控" Width="170" Style="{StaticResource ModernPrimaryButton}" Click="BtnToggleEngine_Click" Margin="0,0,10,0"/>

                    <Button x:Name="BtnSaveConfig" Content="保存当前配置" Width="130" Height="38" Style="{StaticResource ModernSecondaryButton}" Click="BtnSaveConfig_Click"/>
                </StackPanel>

                <Button Grid.Column="1" Content="清空日志" Width="75" Height="38" Style="{StaticResource ModernSecondaryButton}" Click="BtnClearLog_Click"/>
            </Grid>
        </Border>

        <!-- 4. 实时运行日志终端 (Dark Console) -->
        <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14,10,14,10" MinHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 终端顶部小圆点 -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,5,0"/>
                        <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,5,0"/>
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="Live Monitor Audit Console" FontFamily="{StaticResource CodeFont}" FontSize="10.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </Grid>

                <!-- 日志文本框 -->
                <TextBox x:Name="TxtLog" Grid.Row="1" Background="Transparent" Foreground="#38BDF8" 
                         FontFamily="{StaticResource CodeFont}" FontSize="11.5" 
                         IsReadOnly="True" BorderThickness="0" 
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
