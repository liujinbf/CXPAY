APP_DEBUG=false
APP_URL=https://pay.example.com

# CXPAY 主应用固定为独立支付系统；云端控制面使用单独服务和配置
CXPAY_RUNTIME_ROLE=payment

# 独立云端控制面仅配置公开地址；不要在环境文件中配置云端数据库或平台签名私钥
CLOUD_PORTAL_URL=https://cloud.fcwan.cn
CLOUD_API_URL=https://cloud.fcwan.cn

APP_KEY=
ALLOW_PRIVATE_CALLBACKS=false
SYSTEM_UPDATE_ENABLED=false

# 生产环境仅允许 Nginx 反向代理访问 Webman。
HOST=127.0.0.1
PORT=8787
WEBMAN_WORKERS=4

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cxpay
DB_USERNAME=cxpay
DB_PASSWORD=change_me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
