WXCOLLECTOR_CLOUD_URL=https://monitor.example.com
WXCOLLECTOR_ID=authorized-collector-01
WXCOLLECTOR_SECRET=
WXCOLLECTOR_INTERVAL=2
WXCOLLECTOR_ALLOW_HTTP=false
# 未配置时使用安全的不可用适配器，不会产生二维码或账单。
WXCOLLECTOR_ADAPTER_CLASS=WxCollector\UnavailableProviderAdapter

# -----------------------------------------------------------------------
# 微信 PC Hook 适配器（aixed/WeChat-Hook，微信版本 4.1.10.27）
# -----------------------------------------------------------------------
# 使用前：将 version.dll 放入微信安装目录，然后以以下方式启动微信：
#   WeChat.exe StartPort=30001 CallBackURL="http://127.0.0.1:18889/wx-hook-callback"
#
# WXCOLLECTOR_ADAPTER_CLASS=WxCollector\WxPcHookProviderAdapter
WXPC_HOOK_URL=http://127.0.0.1:30001
WXPC_MASTER_KEY=
WXPC_BILL_DB=runtime/wx-pc-bills.sqlite
WXPC_STATE_DIR=runtime/wx-pc-sessions
# 云端颁发的 account_id（第一次授权成功后由 bindAuthorizedAccount 写入，
# 此处可在首次绑定成功后手动填入，加快后续启动速度）
WXPC_CLOUD_ACCOUNT_ID=

# -----------------------------------------------------------------------
# 合法服务商实现标准签名 HTTPS API 后，可切换为：
# WXCOLLECTOR_ADAPTER_CLASS=WxCollector\SignedHttpProviderAdapter
WXPROVIDER_BASE_URL=
WXPROVIDER_CLIENT_ID=
WXPROVIDER_REQUEST_SECRET=
WXPROVIDER_RESPONSE_SECRET=

# -----------------------------------------------------------------------
# 支付宝网页版扫码采集器（非官方网页协议，仅限用户本人授权账号）。
# WXCOLLECTOR_ADAPTER_CLASS=WxCollector\AlipayWebProviderAdapter
ALIC_MASTER_KEY=
ALIC_STATE_DIR=
