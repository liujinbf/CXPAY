WXCOLLECTOR_CLOUD_URL=https://monitor.example.com
WXCOLLECTOR_ID=authorized-collector-01
WXCOLLECTOR_SECRET=
WXCOLLECTOR_INTERVAL=2
WXCOLLECTOR_ALLOW_HTTP=false
# 未配置时使用安全的不可用适配器，不会产生二维码或账单。
WXCOLLECTOR_ADAPTER_CLASS=WxCollector\UnavailableProviderAdapter

# 合法服务商实现标准签名 HTTPS API 后，可切换为：
# WXCOLLECTOR_ADAPTER_CLASS=WxCollector\SignedHttpProviderAdapter
WXPROVIDER_BASE_URL=
WXPROVIDER_CLIENT_ID=
WXPROVIDER_REQUEST_SECRET=
WXPROVIDER_RESPONSE_SECRET=

# 支付宝网页版扫码采集器（非官方网页协议，仅限用户本人授权账号）。
# WXCOLLECTOR_ADAPTER_CLASS=WxCollector\AlipayWebProviderAdapter
ALIC_MASTER_KEY=
ALIC_STATE_DIR=
